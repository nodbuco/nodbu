# Copia este archivo como .env.local y rellena los valores.
#
# IMPORTANTE: las variables NEXT_PUBLIC_* se incrustan EN EL BUILD. El sitio es
# un export estatico, asi que despues de cambiar cualquiera de estas hay que
# volver a ejecutar `npm run build` y subir /out otra vez.

# Clave de acceso de Web3Forms. Gratis en https://web3forms.com
# Se pide con el correo hola@nodbu.com y llega al momento por email.
# Sin esta clave el formulario muestra un aviso y pide escribir por WhatsApp.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Contenedor de Google Tag Manager, formato GTM-XXXXXXX.
# Si se deja vacio no se carga NADA de Google. Rellenalo cuando conectes
# Google Ads para medir los eventos whatsapp_click y lead_submit.
NEXT_PUBLIC_GTM_ID=
