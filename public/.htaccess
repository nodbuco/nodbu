# ============================================================================
#  NODBU — configuracion de Apache para Hostinger (hosting compartido)
#
#  Este archivo vive en /public, asi que Next lo copia tal cual a /out al
#  compilar. Sube el CONTENIDO de /out a public_html, incluido este archivo.
#  En el Administrador de archivos de hPanel hay que activar "mostrar archivos
#  ocultos" para verlo: empieza por punto.
#
#  El sitio se compila con trailingSlash: true, asi que cada ruta es una
#  carpeta con su index.html (/privacidad/index.html). Las reglas de abajo
#  respetan la barra final; si la quitas, Apache deja de encontrar el index.
# ============================================================================

# ----------------------------------------------------------------- rutas ---
<IfModule mod_dir.c>
  # /privacidad/ sirve /privacidad/index.html
  DirectoryIndex index.html
</IfModule>

# Sin listados de directorios.
Options -Indexes

# ------------------------------------------------------------ redirecciones -
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Todo por HTTPS.
  #    Hostinger termina el SSL en un proxy, por eso se mira tambien la
  #    cabecera X-Forwarded-Proto ademas de %{HTTPS}.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 2. www -> dominio raiz.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 3. La pagina de aparcamiento de Hostinger, a la portada.
  #    /default.php es el archivo que el plan trae de fabrica (16.417 bytes,
  #    titulo "Pagina por defecto"). Mientras el despliegue apunto a la
  #    carpeta equivocada, ESO era lo que respondia en nodbu.com, y Google
  #    lo rastreo. Sigue vivo en la raiz del dominio, con 200, sin canonica
  #    y con un contenido identico al de miles de dominios aparcados en
  #    Hostinger: es el "Duplicada: el usuario no ha indicado ninguna
  #    version canonica" que salio en Search Console el 6/9/2026.
  #    Va con 301 a la portada, no con 410, para consolidar ahi el rastreo
  #    de aquella epoca. No se borra el archivo del servidor a proposito:
  #    si Hostinger vuelve a dejarlo caer, la regla lo sigue tapando.
  RewriteRule ^default\.php$ / [R=301,L]

  # 4. /algo/index.html -> /algo/
  #    Apache sirve las dos formas con 200 y son literalmente el mismo
  #    archivo. La canonica ya apunta a la version con barra, asi que
  #    Google no las indexa por duplicado, pero gasta rastreo en ellas.
  #
  #    CUIDADO CON EL BUCLE: la condicion mira THE_REQUEST, que es la linea
  #    original de la peticion ("GET /casos/ HTTP/1.1"), no la ruta ya
  #    reescrita. mod_dir traduce /casos/ a /casos/index.html POR DENTRO y
  #    esa traduccion no toca THE_REQUEST, asi que la regla no se dispara
  #    contra si misma. Si la cambias por %{REQUEST_URI}, el sitio entero
  #    entra en bucle de redirecciones.
  RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # NOTA: no se anade ninguna regla que quite la barra final. El sitio se
  # genera con trailingSlash: true y mod_dir ya redirige /privacidad a
  # /privacidad/ por su cuenta.
</IfModule>

# -------------------------------------------------------------- compresion -
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json

  # Los .woff2 ya vienen comprimidos: volver a comprimirlos solo gasta CPU.
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ------------------------------------------------------------------ cache --
<IfModule mod_expires.c>
  ExpiresActive On

  # Estaticos con nombre versionado (los de /_next/static): cache larga.
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  # El HTML NO se cachea: si no, al subir una version nueva el visitante
  # seguiria viendo la antigua durante dias.
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Inmutable para todo lo que lleva hash en el nombre.
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # El HTML siempre se revalida.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Cabeceras de seguridad basicas.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always unset X-Powered-By
</IfModule>

# --------------------------------------------------------------- mime types -
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# ------------------------------------------------------------------- 404 ---
# Next deja la pagina de error en /404.html al exportar.
ErrorDocument 404 /404.html
